# Optional — only needed for legacy Typer commands (jobreach generate, etc.)
# The interactive shell stores API keys in your OS keychain instead.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Legacy CLI defaults (interactive shell uses ~/.jobreach/config/settings.json)
JOBREACH_AI_PROVIDER=gemini
JOBREACH_AI_MODEL=gemini-1.5-flash
JOBREACH_DATA_DIR=.jobreach
JOBREACH_DEFAULT_DELAY_SECONDS=15
